# Override the bundled RPM demo avatar with your own readyplayer.me URL.
# IMPORTANT: append ?morphTargets=ARKit,Oculus+Visemes so visemes + ARKit blendshapes ship.
# VITE_AVATAR_URL=https://models.readyplayer.me/<your-id>.glb?morphTargets=ARKit,Oculus+Visemes

# LiveKit (Phase 3): replace with your project's wss URL and a JWT minted server-side.
# VITE_LIVEKIT_URL=wss://<your-project>.livekit.cloud
# VITE_LIVEKIT_TOKEN=eyJhbGciOi...
